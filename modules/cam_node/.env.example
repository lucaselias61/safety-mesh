# Defaults for compose.yaml; copy to .env.
# ---------------------------------------Build---------------------------------------

# Parallel build jobs.
BUILD_JOBS=2
# gpu: TensorRT on an NVIDIA GPU, x86-64 only. cpu: OpenCV DNN on the CPU.
INFERENCE=gpu
#OFF ignores RERUN_URL at runtime
RERUN=ON
# Rerun viewer URL; empty disables.
# Same host: rerun+http://host.docker.internal:9876/proxy
# Other host: rerun+http://<host-ip>:9876/proxy
RERUN_URL=
# Max images per second to Rerun; 0 = none
RERUN_IMAGE_FPS=5
# Text log level: debug, info, warn or error
LOG_LEVEL=info
CALIBRATION_DIR=./calibration

# --------------------------------------Camera Streams-------------------------------

CAMERA_SERIAL=
# SDK format names. false turns a stream off. Detection needs color in RGB8 or BGR8.
COLOR_ENABLED=true
COLOR_FORMAT=RGB8
DEPTH_ENABLED=true
DEPTH_FORMAT=Z16
# Color and depth always use the same size and rate. Check with `streams`.
WIDTH=640
HEIGHT=480
FPS=15

# -------------------------------------Inference-------------------------------------

# Host GPU index or UUID for inference (not relevant for CPU-only)
GPU_DEVICE=0
# Path inside the container. Host models/ is mounted at /models.
MODEL_PATH=/models/yolo11n.onnx
# Person score and box overlap thresholds, greater than 0 and at most 1.
CONFIDENCE_THRESHOLD=0.25
NMS_THRESHOLD=0.45
# Square model input size.
INPUT_SIZE=640
# fp32, fp16 or int8. TensorRT only, opencv_dnn needs fp32.
PRECISION=fp32



