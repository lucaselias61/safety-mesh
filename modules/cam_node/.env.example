# Defaults for compose.yaml; copy to .env.
# ---------------------------------------Camera---------------------------------------

# RealSense serial (required). Names the container, selects config/<serial>.json.
# Unknown? Use any placeholder (e.g. "discovery") and run `list` (docs/docker.md).
CAMERA_SERIAL=
CAM_NODE_CONFIG=config/${CAMERA_SERIAL}.json

# -------------------------------------Inference-------------------------------------

# Host GPU index or UUID for inference (not relevant for CPU-only)
GPU_DEVICE=0

# ---------------------------------------Build---------------------------------------

# Parallel build jobs
BUILD_JOBS=4
# OFF builds only OpenCV DNN
TENSORRT=ON
#OFF ignores RERUN_URL at runtime
RERUN=ON
# Rerun viewer URL; empty disables.
# Same host: rerun+http://host.docker.internal:9876/proxy
# Other host: rerun+http://<host-ip>:9876/proxy
RERUN_URL=
# Max images per second to Rerun; 0 = none
RERUN_IMAGE_FPS=5
# Text log level: debug, info, warn or error
LOG_LEVEL=info

