# Defaults for compose.cpu.yaml and compose.gpu.yaml; copy to .env.
# ---------------------------------------Camera---------------------------------------

# RealSense serial (required). Names the container, selects config/<serial>.json.
# Unknown? Use any placeholder (e.g. "discovery") and run `list` (docs/docker.md).
CAMERA_SERIAL=
# To be mounted inside the container at /opt/cam_node/config.json
# Relative to this directory or absolute path.
CAM_NODE_CONFIG_PATH=config/${CAMERA_SERIAL}.json
# Where compose.calibrate.yaml writes <serial>.json pose files.
# Manager on this host: ../manager/config/cameras
CALIBRATION_DIR=./calibration

# -------------------------------------Inference-------------------------------------

# Host GPU index or UUID for inference (not relevant for CPU-only)
GPU_DEVICE=0

# ---------------------------------------Build---------------------------------------

# Parallel build jobs. Each needs 1-2 GB RAM. Use 1 on hosts with 8 GB or less.
BUILD_JOBS=2
# gpu: TensorRT on an NVIDIA GPU, x86-64 only. cpu: OpenCV DNN on the CPU.
# Lowercase only. It names the compose file below.
INFERENCE=gpu
# Loads compose.<INFERENCE>.yaml. Do not edit.
COMPOSE_FILE=compose.${INFERENCE:-gpu}.yaml
#OFF ignores RERUN_URL at runtime
RERUN=ON
# Rerun viewer URL; empty disables.
# Same host: rerun+http://host.docker.internal:9876/proxy
# Other host: rerun+http://<host-ip>:9876/proxy
RERUN_URL=
# Max images per second to Rerun; 0 = none
RERUN_IMAGE_FPS=5
# Text log level: debug, info, warn or error
LOG_LEVEL=info

