# Defaults for tools/ads_pose_probe.py (copy to .env and adjust)

# PLC path of ST_RobotPose (required, no default in the script)
ADS_SYMBOL=GVL.stRobotPose

# PLC IP address
ADS_PLC_IP=192.168.137.49

# PLC AMS Net ID
ADS_PLC_NET_ID=130.149.137.49.1.1

# AMS port (852 = PLC runtime 2)
ADS_PORT=852

# AMS Net ID of this machine (must match the static route on the PLC)
ADS_LOCAL_NET_ID=192.168.137.168.1.1

# Polls per second
ADS_RATE=10.0

# Also print the raw bytes (true/false)
ADS_RAW=false
