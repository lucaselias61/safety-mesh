# Values for compose.yaml. Copy to .env and edit:
#   cp .env.example .env
# - Every line goes into both camera containers.

#–––––––––––––––––––––––––––BUILD––––––––––––––––––––––––––––––
# cpu: OpenCV DNN. gpu: TensorRT on an NVIDIA GPU, x86-64 only.
INFERENCE=cpu
# GPU index or UUID, gpu only.
GPU_DEVICE=0
BUILD_JOBS=2
RERUN=ON

#–––––––––––––––––––––LOGGING AND VIEWER–––––––––––––––––––––––
LOG_LEVEL=info
RERUN_URL=rerun+http://rerun:9876/proxy
RERUN_IMAGE_FPS=5
RERUN_CAMERAS=311322304407,233522074709
RERUN_PORT=9876
RERUN_WEB_VIEWER_PORT=9090
RERUN_MEMORY_LIMIT=2GB

#–––––––––––––––––––––––CAMERA STREAMS–––––––––––––––––––––––––
COLOR_ENABLED=true
COLOR_FORMAT=RGB8
DEPTH_ENABLED=true
DEPTH_FORMAT=Z16
WIDTH=640
HEIGHT=480
FPS=15

#––––––––––––––––––––––––––INFERENCE–––––––––––––––––––––––––––
MODEL_PATH=/models/yolo11n.onnx
CONFIDENCE_THRESHOLD=0.25
NMS_THRESHOLD=0.45
INPUT_SIZE=640
PRECISION=fp32
